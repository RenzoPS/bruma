# Variables del stack local de `docker compose`. Copiar a `.env` y completar.
#
#   cp .env.example .env
#
# Este archivo NO lo lee la api directamente: compose arma DATABASE_URL a partir
# de estas piezas, porque adentro de la red el host es `postgres` y desde el
# host es `localhost`. Para correr la api o las migraciones fuera de Docker, ver
# apps/api/.env.example.

# --- Postgres local (contenedor, datos descartables) ---
POSTGRES_USER=bruma
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=bruma

# --- Puertos publicados en el host ---
# Si ya tenes un Postgres escuchando en 5432, cambia este y el puerto del
# DATABASE_URL de apps/api/.env por uno libre.
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000

# --- Modelos ---
# Google AI Studio -> Get API key. Free tier, no pide tarjeta.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- CORS ---
# De donde se sirve el sitio. En el stack local es el puerto que publica `web`.
ORIGENES_WEB=http://localhost:3000
