# Toda la configuracion del proyecto, en un solo archivo. Copiar a `.env` y
# completar:
#
#   cp .env.example .env
#
# Lo lee `docker compose` (interpola los ${...} de docker-compose.yaml) y tambien todo
# lo que corre fuera de Docker: `pnpm dev` de la api, drizzle-kit y los scripts
# de RAG, que lo reciben por `--env-file=../../.env`. Un solo lugar para la
# password de Postgres y la API key, que antes estaban escritas dos veces.

# --- Postgres local (contenedor, datos descartables) ---
POSTGRES_USER=bruma
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=bruma

# --- Puertos publicados en el host ---
# Si ya tenes un Postgres escuchando en 5432, cambia este por uno libre y
# acordate de cambiar tambien el puerto del DATABASE_URL de mas abajo.
POSTGRES_PORT=5432
API_PORT=3001
WEB_PORT=3000

# --- Modelos ---
# Google AI Studio -> Get API key. Free tier, no pide tarjeta.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Como llegar a la base desde el host ---
# Solo lo usa lo que corre FUERA de Docker. Adentro de la red de compose el
# host de Postgres es `postgres` y no `localhost`, asi que compose vuelve a
# definir esta variable en su `environment:` y pisa la de aca.
#
# Va escrita entera y no armada con ${POSTGRES_USER}: el --env-file de Node no
# expande variables. Si cambias usuario, clave, base o puerto arriba, cambiala
# aca tambien. Si preferis una base gestionada, Neon (neon.com) da Postgres con
# pgvector gratis y alcanza con pegar su connection string.
DATABASE_URL=postgresql://bruma:cambiar_esto@localhost:5432/bruma

# --- CORS ---
# De donde se sirve el sitio. En el stack local es el puerto que publica `web`.
# Tiene default (http://localhost:3000), asi que podes dejarla vacia.
ORIGENES_WEB=http://localhost:3000

# --- URL publica del sitio ---
# La usa el front para las URL absolutas de la tarjeta social (Open Graph), el
# robots.txt y el sitemap.xml. Tiene default (http://localhost:3000) y en local
# se puede dejar asi: lo unico que cambia es que la tarjeta apunte a localhost.
#
# NEXT_PUBLIC_ no es un capricho: el layout se prerenderiza, asi que Next tiene
# que poder leerla en build time. En el deploy va la URL de produccion; en un
# preview de Vercel, la del preview.
NEXT_PUBLIC_SITIO=http://localhost:3000
