# Connection string de Postgres. Dos opciones:
#
#   local  — el Postgres del `docker compose` de la raiz, publicado en 5432.
#            Las credenciales salen del `.env` de la raiz.
#   Neon   — Dashboard -> Connection Details.
#
# `localhost` y no `postgres`: este archivo lo lee la api (o drizzle-kit)
# corriendo en la maquina, fuera de la red de compose. El puerto es el que
# publica el compose (POSTGRES_PORT), no necesariamente 5432.
DATABASE_URL=postgresql://bruma:password@localhost:5432/bruma
# DATABASE_URL=postgresql://usuario:password@host.neon.tech/bruma?sslmode=require

# Google AI Studio -> Get API key. Free tier, no pide tarjeta.
GOOGLE_GENERATIVE_AI_API_KEY=

PORT=3001
NODE_ENV=development

# Origenes que pueden llamar a esta API desde un navegador, separados por coma.
# Es una lista blanca y no un *: con * cualquier pagina de internet puede
# gastarle la cuota de Gemini a este proyecto desde el navegador de un visitante.
ORIGENES_WEB=http://localhost:3000
